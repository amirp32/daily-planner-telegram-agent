    {
      "parameters": {
        "jsCode": "// Parse decision — turns the model's answer into a safe, validated decision\nconst res = $input.first().json;\nconst todayIds = $('Get today tasks').all().map(i => Number(i.json.id)).filter(Boolean);\n\n// 1) The AI service returned an error (quota finished, model busy, wrong key, ...)\nif (res.error || !res.choices) {\n  const msg = (res.error && res.error.message) ? res.error.message : 'no answer';\n  return [{ json: { action: 'chat', tasks: [], done_ids: [],\n    text: `مدل هوش مصنوعی الان جواب نداد (${msg}).\\nچند دقیقه بعد دوباره پیامت را بفرست. اگر تکرار شد، بخش عیب‌یابی راهنما را ببین.` } }];\n}\n\n// 2) Pull the JSON out of the answer, even if the model added extra text around it\nconst raw = res.choices[0]?.message?.content || '';\nlet d = null;\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  d = JSON.parse(m ? m[0] : raw);\n} catch (e) { d = null; }\n\nif (!d || typeof d !== 'object') {\n  return [{ json: { action: 'chat', tasks: [], done_ids: [],\n    text: 'جوابم قاطی شد و نتوانستم بفهمم چه کاری باید بکنم. می‌شود پیامت را ساده‌تر بنویسی؟' } }];\n}\n\n// 3) Validate every field (guardrails): the model is not trusted blindly\nconst allowed = ['add_tasks', 'mark_done', 'report', 'chat'];\nlet action = allowed.includes(d.action) ? d.action : 'chat';\n\nconst tasks = (Array.isArray(d.tasks) ? d.tasks : [])\n  .filter(t => t && typeof t.title === 'string' && t.title.trim())\n  .slice(0, 15)\n  .map(t => ({\n    title: t.title.trim().slice(0, 200),\n    priority: ['high', 'medium', 'low'].includes(t.priority) ? t.priority : 'medium',\n    estimate_min: Math.min(Math.max(parseInt(t.estimate_min, 10) || 30, 5), 480)\n  }));\n\n// Only ids that really exist today are accepted\nconst done_ids = (Array.isArray(d.done_ids) ? d.done_ids : [])\n  .map(Number).filter(id => todayIds.includes(id));\n\nlet text = (typeof d.reply === 'string' && d.reply.trim()) ? d.reply.trim() : 'باشه.';\nif (action === 'add_tasks' && tasks.length === 0) {\n  action = 'chat'; text = 'کاری برای ثبت پیدا نکردم. کارهایت را واضح‌تر بنویس، مثلاً: «امروز باید گزارش را بفرستم و ورزش کنم».';\n}\nif (action === 'mark_done' && done_ids.length === 0) {\n  action = 'chat'; text = 'نفهمیدم کدام کار تمام شده. اسم کار را دقیق‌تر بنویس (اول یک «گزارش» بگیر تا فهرست امروز را ببینی).';\n}\nreturn [{ json: { action, tasks, done_ids, text } }];\n"
      },
      "id": "ca28c5f4-c353-4494-aa0d-cd6c4392e4aa",
      "name": "Parse decision",
