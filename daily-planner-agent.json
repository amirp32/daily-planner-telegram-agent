      "id": "0b6a99bd-da5d-494f-be59-d094a8d0359d",
      "name": "Get tasks for report",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        2720,
        620
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Calculate KPI — numbers are computed with code, not by the AI (AI is bad at arithmetic)\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nconst W = { high: 3, medium: 2, low: 1 };\n\nconst total = rows.length;\nconst done = rows.filter(r => r.status === 'done');\nconst high = rows.filter(r => r.priority === 'high');\nconst highDone = high.filter(r => r.status === 'done');\nconst sum = arr => arr.reduce((s, r) => s + (Number(r.estimate_min) || 0), 0);\nconst pct = (a, b) => (b ? Math.round((a / b) * 100) : 0);\n\nconst plannedMin = sum(rows);\nconst doneMin = sum(done);\nconst weightAll = rows.reduce((s, r) => s + (W[r.priority] || 2), 0);\nconst weightDone = done.reduce((s, r) => s + (W[r.priority] || 2), 0);\n\nconst kpi = {\n  date: cfg.today,\n  total_tasks: total,\n  done_tasks: done.length,\n  completion_rate: pct(done.length, total),\n  high_priority_rate: high.length ? pct(highDone.length, high.length) : null,\n  planned_min: plannedMin,\n  done_min: doneMin,\n  capacity_min: Number(cfg.daily_capacity_min),\n  planning_accuracy: plannedMin ? pct(Math.min(plannedMin, cfg.daily_capacity_min), plannedMin) : null,\n  day_score: pct(weightDone, weightAll),\n  open_tasks: rows.filter(r => r.status !== 'done').map(r => r.title)\n};\n\nlet text;\nif (total === 0) {\n  text = `📊 گزارش ${kpi.date}\\nامروز هیچ کاری ثبت نشده بود. فردا صبح کارهایت را برایم بفرست تا گزارش واقعی داشته باشیم.`;\n} else {\n  text = [\n    `📊 گزارش ${kpi.date}`,\n    `امتیاز روز (وزن‌دار با اولویت): ${kpi.day_score}٪`,\n    `نرخ انجام: ${kpi.done_tasks} از ${kpi.total_tasks} کار (${kpi.completion_rate}٪)`,\n    `کارهای اولویت بالا: ${kpi.high_priority_rate === null ? 'نداشتی' : kpi.high_priority_rate + '٪ انجام شد'}`,\n    `زمان برنامه‌ریزی‌شده: ${kpi.planned_min} دقیقه (ظرفیت: ${kpi.capacity_min})`,\n    `زمان کارهای انجام‌شده: ${kpi.done_min} دقیقه`,\n    `واقع‌بینی برنامه: ${kpi.planning_accuracy}٪`,\n    kpi.open_tasks.length ? `باز مانده: ${kpi.open_tasks.join('، ')}` : 'هیچ کاری باز نمانده.'\n  ].join('\\n');\n}\n\nreturn [{ json: { kpi, text, coach_body: {\n  model: cfg.model,\n  temperature: 0.4,\n  messages: [\n    { role: 'system', content: 'You are a calm, honest productivity coach. Read the KPI JSON and write exactly 3 short lines in Persian (Farsi): 1) one real positive point, 2) one pattern or problem you see in the numbers, 3) one concrete, small suggestion for tomorrow. No exaggeration, no emojis, no headings.' },\n    { role: 'user', content: JSON.stringify(kpi) }\n  ]\n} } }];\n"
      },
      "id": "d9cde251-f769-476b-8371-e06187d0212c",
      "name": "Calculate KPI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2940,
        620
      ]
    },
