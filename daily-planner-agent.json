    {
      "parameters": {
        "jsCode": "// Compose report — KPI numbers + coach advice (if the AI answered)\nconst base = $('Calculate KPI').first().json;\nconst res = $input.first().json;\nconst advice = res && res.choices ? (res.choices[0]?.message?.content || '').trim() : '';\nconst text = (base.kpi.total_tasks > 0 && advice)\n  ? `${base.text}\\n\\n🧭 نکته‌های مربی:\\n${advice}`\n  : base.text;\nreturn [{ json: { text } }];\n"
      },
