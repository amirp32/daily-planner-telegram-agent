      "id": "516c2381-88a3-41ac-adda-6640a393c19e",
      "name": "AI brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "OpenRouter key"
        }
      }
