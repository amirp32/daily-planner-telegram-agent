      "id": "ebb13e21-bc72-4a81-bb88-e7d09d1317eb",
      "name": "Get updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Read messages — reads new Telegram updates and keeps only YOUR messages\nconst cfg = $('Config').first().json;\nconst updates = $input.first().json.result || [];\n\n// No new update? Stop here (nothing below runs, no AI request is spent).\nif (updates.length === 0) return [];\n\nconst nextOffset = Math.max(...updates.map(u => u.update_id)) + 1;\nconst myId = String(cfg.my_chat_id || '').trim();\nconst msgs = updates.filter(u => u.message && u.message.text);\n\n// Setup mode: you haven't entered your chat id yet -> bot tells you what it is.\nif (!myId || myId === '0') {\n  const first = msgs[0];\n  return [{ json: {\n    kind: first ? 'setup' : 'none',\n    next_offset: nextOffset,\n    chat_id: first ? first.message.chat.id : null,\n    text: first ? `سلام! chat id تو این عدد است:\\n${first.message.chat.id}\\nاین عدد را در نود Config جلوی my_chat_id بگذار و ورک‌فلو را دوباره Publish کن.` : ''\n  } }];\n}\n\n// Guardrail: only messages from your own chat are processed. Others are ignored.\nconst mine = msgs.filter(u => String(u.message.chat.id) === myId);\nreturn [{ json: {\n  kind: mine.length ? 'message' : 'none',\n  next_offset: nextOffset,\n  text: mine.map(u => u.message.text).join('\\n')\n} }];\n"
      },
